	<element name="str_enderecamento_spaces"><text string="E N D E R E Ç A M E N T O"><color red="0" green="0" blue="0" /></text></element>
	<element name="str_memoria_spaces"><text string="M   E   M   Ó   R   I   A"><color red="0" green="0" blue="0" /></text></element>
	<element name="str_entrada_saida">
		<text string="E N T R A D A">
			<bounds x="0" y="0" width="48" height="18"></bounds><color red="0" green="0" blue="0" />
		</text>
		<text string="E">
			<bounds x="0" y="20" width="48" height="18"></bounds><color red="0" green="0" blue="0" />
		</text>
		<text string="S A Í D A">
			<bounds x="0" y="40" width="48" height="18"></bounds><color red="0" green="0" blue="0" />
