Front panel of the Patinho Feio mini-computer with clickable buttons, switches and lamps.
-->

<mamelayout version="2">

<!-- define elements -->

	<element name="ula">
		<image><data><![CDATA[
			<svg width="210" height="270">
				<path
					fill="#a11022" stroke="#000" stroke-width="10"
					d="m 5,5 v 120 l 85,10 -85,10 v 120 l 200,-40 v -180 z"
				/>
			</svg>
		]]></data></image>
	</element>

		<!-- Two rotary switch elements, one per lever: each knob has a label on
	     both sides, and for the same bit value the two levers rest on
	     opposite sides, so a single shared element cannot serve both.

	         ENDERECAMENTO   FIXO (left)      SEQUENCIAL (right)
	         MEMORIA         LIBERADA (left)  PROTEGIDA (right)

	     Bit 0 points ENDERECAMENTO at FIXO, as the processor assumes
	     (patinhofeio_cpu.h: 0 = Fixo, 1 = Sequencial), and MEMORIA at
	     PROTEGIDA, a declared choice rather than a documented power-on
	     state: the knobs are physical, and the assembly procedure on page
	     16.12 merely leaves the memory protected at step i).  Nothing fixes
	     the electrical value of either lever; the panel BUTTONS register is
	     a fiction of this emulator. -->

	<element name="rotary_switch_enderecamento" defstate="0">
		<!-- button_surrond_border -->
		<disk>
			<bounds x="0" y="0" width="37" height="37"/>
			<color red="0" green="0" blue="0"/>
		</disk>

		<!-- button_surrond -->
		<disk>
			<bounds x="2" y="2" width="33" height="33"/>
			<color red="0.04" green="0.09" blue="0.1"/>
		</disk>

		<!-- button_border -->
		<disk>
			<bounds x="4" y="4" width="29" height="29"/>
			<color red="0" green="0.32" blue="0"/>
		</disk>

		<!-- button -->
		<disk>
			<bounds x="6" y="6" width="25" height="25"/>
			<color red="0" green="0.5" blue="0"/>
		</disk>

		<!-- arrow: 0 points up and left, at F I X O -->
		<image state="0">
			<bounds x="10" y="10" width="20" height="20"/>
			<data><![CDATA[
				<svg width="20" height="20">
					<path
						fill="#b3b3b3" stroke="#808080" stroke-width="1"
						d="m 0.5,14.5 4,-4 8,8 6,-6 -8,-8 4,-4 h -14 z" />
				</svg>
			]]></data>
		</image>
		<!-- arrow: 1 points up and right, at SEQUENCIAL -->
		<image state="1">
			<bounds x="7" y="10" width="20" height="20"/>
			<data><![CDATA[
				<svg width="20" height="20">
					<path
						fill="#b3b3b3" stroke="#808080" stroke-width="1"
						d="m 5.5,0.5 4,4 -8,8 6,6 8,-8 4,4 v -14 z" />
				</svg>
			]]></data>
		</image>
	</element>

	<element name="rotary_switch_memoria" defstate="0">
		<!-- button_surrond_border -->
		<disk>
			<bounds x="0" y="0" width="37" height="37"/>
			<color red="0" green="0" blue="0"/>
		</disk>

		<!-- button_surrond -->
		<disk>
			<bounds x="2" y="2" width="33" height="33"/>
			<color red="0.04" green="0.09" blue="0.1"/>
		</disk>

		<!-- button_border -->
		<disk>
			<bounds x="4" y="4" width="29" height="29"/>
			<color red="0" green="0.32" blue="0"/>
		</disk>

		<!-- button -->
		<disk>
			<bounds x="6" y="6" width="25" height="25"/>
			<color red="0" green="0.5" blue="0"/>
		</disk>

		<!-- arrow: 0 points up and right, at PROTEGIDA -->
		<image state="0">
			<bounds x="7" y="10" width="20" height="20"/>
			<data><![CDATA[
				<svg width="20" height="20">
					<path
						fill="#b3b3b3" stroke="#808080" stroke-width="1"
						d="m 5.5,0.5 4,4 -8,8 6,6 8,-8 4,4 v -14 z" />
				</svg>
			]]></data>
		</image>
		<!-- arrow: 1 points up and left, at LIBERADA -->
		<image state="1">
			<bounds x="10" y="10" width="20" height="20"/>
			<data><![CDATA[
				<svg width="20" height="20">
					<path
						fill="#b3b3b3" stroke="#808080" stroke-width="1"
						d="m 0.5,14.5 4,-4 8,8 6,-6 -8,-8 4,-4 h -14 z" />
				</svg>
			]]></data>
		</image>
	</element>

	<element name="state_lamp" defstate="0">
		<!-- external border -->
		<disk>
			<bounds x="0" y="0" width="36" height="36"/>
			<color red="0" green="0" blue="0"/>
		</disk>

		<!-- surround border -->
		<disk>
			<bounds x="2" y="2" width="32" height="32"/>
			<color red="0.04" green="0.09" blue="0.1"/>
		</disk>

		<!-- internal border -->
		<disk>
			<bounds x="7" y="7" width="22" height="22"/>
			<color red="0.29" green="0.35" blue="0.44"/>
		</disk>

		<!-- lamp -->
		<disk state="0">
			<bounds x="8" y="8" width="20" height="20"/>
			<color red="0.40" green="0.48" blue="0.61"/>
		</disk>
		<disk state="1">
			<bounds x="8" y="8" width="20" height="20"/>
			<color red="1" green="1" blue="1"/>
		</disk>
	</element>

	<element name="diagram_rect">
		<image><data><![CDATA[
			<svg width="78" height="70">
				<path
					fill="#598162" stroke="#000" stroke-width="1"
					d="m 38,0 v 16.5 m -37.5,0 v 53 h 77 v -53 z"/>
			</svg>
		]]></data></image>
	</element>

