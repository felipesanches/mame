			<bounds x="0" y="0" width="68" height="12"></bounds><color red="0" green="0" blue="0" />
		</text>
		<text string="Ú N I C A">
			<bounds x="0" y="13" width="68" height="12"></bounds><color red="0" green="0" blue="0" />
