	<element name="str_fixo"><text string="F I X O"><color red="0" green="0" blue="0"/></text></element>
	<element name="str_sequencial"><text string="SEQÜENCIAL"><color red="0" green="0" blue="0"/></text></element>
	<element name="str_liberada"><text string="LIBERADA"><color red="0" green="0" blue="0"/></text></element>
	<element name="str_protegida"><text string="PROTEGIDA"><color red="0" green="0" blue="0"/></text></element>

	<!-- a frame around the strip of paper, so that the teleprinter can be
	     told from the background of the view while nothing is printed yet -->
	<element name="moldura_papel">
		<rect><color red="0.75" green="0.78" blue="0.75"/></rect>
	</element>

	<!-- printed over the black of the teleprinter, not over panel green -->
	<element name="str_teleimpressor">
		<text string="T E L E I M P R E S S O R   /B" align="1">
			<color red="0.75" green="0.78" blue="0.75"/>
		</text>
	</element>

	<!-- numeros 0-9 -->
	<repeat count="10">
		<param name="i" start="0" increment="1"/>
		<element name="str_num_~i~">
			<!-- text background -->
			<rect>
				<color red="0.47" green="0.64" blue="0.51" />
				<bounds x="0" y="0" width="18" height="16"/>
			</rect>
			<!-- text value -->
			<text string="~i~">
				<color red="0" green="0" blue="0"/>
				<bounds x="0" y="0" width="18" height="16"/>
			</text>
		</element>
	</repeat>
	<!-- numeros 10-11 -->
	<repeat count="2">
		<param name="i" start="10" increment="1"/>
		<element name="str_num_~i~">
			<!-- text background -->
			<rect>
				<color red="0.47" green="0.64" blue="0.51" />
				<bounds x="0" y="0" width="18" height="16"/>
			</rect>
			<!-- text value -->
			<text string="~i~">
				<color red="0" green="0" blue="0"/>
				<bounds x="4" y="0" width="14" height="16"/>
			</text>
		</element>
	</repeat>

<!-- The panel drawing lives in a group so that several views can show it
     without a second copy.  The group's own coordinate system is
     1280 x 1200, which is why the views below need no explicit bounds. -->

	<group name="painel">
		<bounds x="0" y="0" width="1280" height="1200" />

		<element ref="panel_background">
			<bounds x="0" y="0" width="1280" height="1200" />
