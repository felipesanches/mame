	</element>
	<element name="str_ARMAZENAMENTO">
		<text string="ARMAZENAMENTO"><color red="0" green="0" blue="0" /></text>
	</element>
	<element name="str_EXPOSICAO">
		<text string="E X P O S I Ç Ã O"><color red="0" green="0" blue="0" /></text>
	</element>
	<element name="str_ESPERA">
		<text string="E S P E R A"><color red="0" green="0" blue="0" /></text>
