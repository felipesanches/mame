			<bounds x="4" y="4" width="48" height="38"/>
			<color red="0.3" green="0.3" blue="0.3" />
		</rect>

		<!-- button_border -->
		<rect>
			<bounds x="8" y="8" width="40" height="30"/>
			<color red="0.8" green="0.8" blue="0.8" />
		</rect>

		<!-- button -->
		<rect state="0">
			<bounds x="12" y="12" width="32" height="22"/>
			<color red="1" green="1" blue="1" />
		</rect>
		<rect state="1">
			<bounds x="12" y="12" width="30" height="30"/>
			<color red="1" green="1" blue="1" />
		</rect>
	</element>

	<element name="memory_rect">
