	<element name="circle">
		<disk><color red="0" green="0" blue="0" /></disk>
	</element>

	<element name="line">
		<rect><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="panel_background">
		<rect><color red="0.47" green="0.64" blue="0.51" /></rect>
	</element>

	<element name="str_flags_t">
