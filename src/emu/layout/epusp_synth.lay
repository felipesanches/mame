		<element ref="tecla_branca" inputtag="TECL0" inputmask="0x0800"><bounds x="419"  y="900" width="26" height="130"/></element>
		<element ref="tecla_branca" inputtag="TECL0" inputmask="0x1000"><bounds x="445"  y="900" width="26" height="130"/></element>
		<element ref="tecla_branca" inputtag="TECL0" inputmask="0x4000"><bounds x="471"  y="900" width="26" height="130"/></element>
		<element ref="tecla_branca" inputtag="TECL1" inputmask="0x0001"><bounds x="497"  y="900" width="26" height="130"/></element>
		<element ref="tecla_branca" inputtag="TECL1" inputmask="0x0002"><bounds x="523"  y="900" width="26" height="130"/></element>
		<element ref="tecla_branca" inputtag="TECL1" inputmask="0x0008"><bounds x="549"  y="900" width="26" height="130"/></element>
