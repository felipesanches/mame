		<element ref="str_transp_faixa" inputtag="TRANSP" inputmask="0x07" inputraw="yes">
			<bounds x="950" y="806" width="290" height="14"/>
		</element>

				<!-- 49-key manual written key by key: the octaves do not line up with
		     the ports (TECL0 = keys 0-15, TECL1 = 16-31, TECL2 = 32-47, TECL3
		     = key 48), so a repeat would mismap.  White keys are 26 wide at
