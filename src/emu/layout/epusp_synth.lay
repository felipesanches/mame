<?xml version="1.0"?>
<!--
license:CC0-1.0
copyright-holders:Felipe Sanches

Front panel of the EPUSP sound synthesiser (Guido Stolfi, ~1975), plugged into
the duplex board on the Patinho Feio's channel /6.  The 49-key manual is that
of chapter 6; its L, D and VBR outputs (envelope, vibrato) are not modelled.

The graphic panel's sixteen sliders are a declared stand-in for the real
control, which chapter 11 gives as "16 chaves de entrada" per bit unit - four
bit units, 64 switches in all.  One slider per sample carries the same 16 x 4
bits; the panel prints the real switch count.

The slider and knob library at the end of this file is a verbatim copy of the
one in src/mame/layout/pg1000.lay; update it there, not by hand here.
-->

<mamelayout version="2">

<!-- =====================================================================
     ELEMENTS
     ===================================================================== -->

	<!-- panel and title bars -->

	<element name="fundo_painel">
		<rect><color red="0.66" green="0.64" blue="0.58"/></rect>
	</element>

	<element name="faixa_titulo">
		<rect><bounds x="0" y="0" width="400" height="30"/><color red="0" green="0" blue="0"/></rect>
		<rect><bounds x="2" y="2" width="396" height="26"/><color red="0.83" green="0.33" blue="0"/></rect>
	</element>

	<element name="traco">
		<rect><color red="0" green="0" blue="0"/></rect>
	</element>

	<!-- the graphic panel's sixteen sliders -->

	<element name="canal_chave">
		<rect><color red="0.10" green="0.11" blue="0.10"/></rect>
	</element>

	<element name="trilho_chave">
		<rect><color red="0.22" green="0.23" blue="0.21"/></rect>
	</element>

	<!-- the bar that draws the sample: same orange as the title bars, so the
	     waveform reads as the panel's one live quantity -->
	<element name="barra_onda">
		<rect><color red="0.90" green="0.42" blue="0.05"/></rect>
	</element>

	<element name="area_invisivel">
		<rect><color red="0" green="0" blue="0" alpha="0"/></rect>
	</element>

	<!-- state 1 is "the pointer is dragging me", set by the script -->
	<element name="cursor_chave" defstate="0">
		<rect>
			<bounds x="0" y="0" width="52" height="20"/>
			<color red="0" green="0" blue="0"/>
		</rect>
		<rect>
			<bounds x="1" y="1" width="50" height="18"/>
			<color state="0" red="0.16" green="0.17" blue="0.16"/>
			<color state="1" red="0.30" green="0.34" blue="0.30"/>
		</rect>
		<rect>
			<bounds x="1" y="2" width="50" height="2"/>
			<color red="0.34" green="0.36" blue="0.34"/>
		</rect>
		<!-- the reading edge: the cursor's centre line is the sample value -->
		<rect>
			<bounds x="0" y="8" width="52" height="4"/>
			<color red="0.86" green="0.86" blue="0.82"/>
		</rect>
	</element>

	<!-- the S1 selector: a nine-position pointer knob.  The pointer is one
	     SVG per position rather than an interpolated bounds, because a knob
	     turns and interpolated bounds only slide. -->

	<element name="knob_s1" defstate="1">
		<image><data><![CDATA[
			<svg width="160" height="160">
				<circle cx="80" cy="80" r="78" fill="#000000"/>
				<circle cx="80" cy="80" r="73" fill="#0a1719"/>
				<circle cx="80" cy="80" r="62" fill="#005200"/>
				<circle cx="80" cy="80" r="56" fill="#008000"/>
			</svg>
		]]></data></image>
		<image state="0"><data><![CDATA[
			<svg width="160" height="160"><g transform="rotate(-120 80 80)">
				<rect x="75" y="26" width="10" height="46" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="80" cy="80" r="9" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="1"><data><![CDATA[
			<svg width="160" height="160"><g transform="rotate(-90 80 80)">
				<rect x="75" y="26" width="10" height="46" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="80" cy="80" r="9" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="2"><data><![CDATA[
			<svg width="160" height="160"><g transform="rotate(-60 80 80)">
				<rect x="75" y="26" width="10" height="46" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="80" cy="80" r="9" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="3"><data><![CDATA[
			<svg width="160" height="160"><g transform="rotate(-30 80 80)">
				<rect x="75" y="26" width="10" height="46" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="80" cy="80" r="9" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="4"><data><![CDATA[
			<svg width="160" height="160"><g transform="rotate(0 80 80)">
				<rect x="75" y="26" width="10" height="46" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="80" cy="80" r="9" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="5"><data><![CDATA[
			<svg width="160" height="160"><g transform="rotate(30 80 80)">
				<rect x="75" y="26" width="10" height="46" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="80" cy="80" r="9" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="6"><data><![CDATA[
			<svg width="160" height="160"><g transform="rotate(60 80 80)">
				<rect x="75" y="26" width="10" height="46" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="80" cy="80" r="9" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="7"><data><![CDATA[
			<svg width="160" height="160"><g transform="rotate(90 80 80)">
				<rect x="75" y="26" width="10" height="46" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="80" cy="80" r="9" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="8"><data><![CDATA[
			<svg width="160" height="160"><g transform="rotate(120 80 80)">
				<rect x="75" y="26" width="10" height="46" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="80" cy="80" r="9" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
	</element>

	<!-- the octave transposition: seven positions -->
	<element name="knob_transp" defstate="2">
		<image><data><![CDATA[
			<svg width="90" height="90">
				<circle cx="45" cy="45" r="44" fill="#000000"/>
				<circle cx="45" cy="45" r="41" fill="#0a1719"/>
				<circle cx="45" cy="45" r="35" fill="#005200"/>
				<circle cx="45" cy="45" r="31" fill="#008000"/>
			</svg>
		]]></data></image>
		<image state="0"><data><![CDATA[
			<svg width="90" height="90"><g transform="rotate(-90 45 45)">
				<rect x="41" y="14" width="8" height="26" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="45" cy="45" r="6" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="1"><data><![CDATA[
			<svg width="90" height="90"><g transform="rotate(-60 45 45)">
				<rect x="41" y="14" width="8" height="26" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="45" cy="45" r="6" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="2"><data><![CDATA[
			<svg width="90" height="90"><g transform="rotate(-30 45 45)">
				<rect x="41" y="14" width="8" height="26" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="45" cy="45" r="6" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="3"><data><![CDATA[
			<svg width="90" height="90"><g transform="rotate(0 45 45)">
				<rect x="41" y="14" width="8" height="26" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="45" cy="45" r="6" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="4"><data><![CDATA[
			<svg width="90" height="90"><g transform="rotate(30 45 45)">
				<rect x="41" y="14" width="8" height="26" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="45" cy="45" r="6" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="5"><data><![CDATA[
			<svg width="90" height="90"><g transform="rotate(60 45 45)">
				<rect x="41" y="14" width="8" height="26" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="45" cy="45" r="6" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="6"><data><![CDATA[
			<svg width="90" height="90"><g transform="rotate(90 45 45)">
				<rect x="41" y="14" width="8" height="26" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="45" cy="45" r="6" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
	</element>

	<!-- the keyboard's manual-automatico switch: two positions -->
	<element name="chave_2pos" defstate="1">
		<image><data><![CDATA[
			<svg width="64" height="64">
				<circle cx="32" cy="32" r="31" fill="#000000"/>
				<circle cx="32" cy="32" r="29" fill="#0a1719"/>
				<circle cx="32" cy="32" r="25" fill="#005200"/>
				<circle cx="32" cy="32" r="22" fill="#008000"/>
			</svg>
		]]></data></image>
		<image state="0"><data><![CDATA[
			<svg width="64" height="64"><g transform="rotate(-40 32 32)">
				<rect x="29" y="9" width="6" height="20" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="32" cy="32" r="5" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
		<image state="1"><data><![CDATA[
			<svg width="64" height="64"><g transform="rotate(40 32 32)">
				<rect x="29" y="9" width="6" height="20" fill="#b3b3b3" stroke="#808080" stroke-width="2"/>
				<circle cx="32" cy="32" r="5" fill="#b3b3b3"/>
			</g></svg>
		]]></data></image>
	</element>

	<!-- one indicator lamp per S1 position: lit when the raw port value is i -->
	<repeat count="9">
		<param name="i" start="0" increment="1"/>
		<element name="lampada_s1_~i~" defstate="0">
			<disk><bounds x="0" y="0" width="14" height="14"/><color red="0" green="0" blue="0"/></disk>
			<disk><bounds x="2" y="2" width="10" height="10"/><color red="0.40" green="0.48" blue="0.61"/></disk>
			<disk state="~i~"><bounds x="2" y="2" width="10" height="10"/><color red="1" green="1" blue="1"/></disk>
		</element>
	</repeat>

	<!-- the same lamp, for the two positions of the manual-automatico switch -->
	<repeat count="2">
		<param name="i" start="0" increment="1"/>
		<element name="lampada_tecl_~i~" defstate="1">
			<disk><bounds x="0" y="0" width="14" height="14"/><color red="0" green="0" blue="0"/></disk>
			<disk><bounds x="2" y="2" width="10" height="10"/><color red="0.40" green="0.48" blue="0.61"/></disk>
			<disk state="~i~"><bounds x="2" y="2" width="10" height="10"/><color red="1" green="1" blue="1"/></disk>
		</element>
	</repeat>

	<!-- the seven TRANSFERE commands: momentary, so they light while held -->
	<element name="botao_transfere" defstate="0">
		<disk><bounds x="0" y="0" width="56" height="56"/><color red="0" green="0" blue="0"/></disk>
		<disk><bounds x="3" y="3" width="50" height="50"/><color red="0.04" green="0.09" blue="0.1"/></disk>
		<disk><bounds x="6" y="6" width="44" height="44"/><color red="0" green="0.32" blue="0"/></disk>
		<disk state="0"><bounds x="9" y="9" width="38" height="38"/><color red="0" green="0.5" blue="0"/></disk>
		<disk state="1"><bounds x="9" y="9" width="38" height="38"/><color red="0" green="1" blue="0"/></disk>
	</element>

	<!-- the 49-key manual -->
	<element name="tecla_branca" defstate="0">
		<rect><bounds x="0" y="0" width="26" height="130"/><color red="0" green="0" blue="0"/></rect>
		<rect>
			<bounds x="1" y="0" width="24" height="128"/>
			<color state="0" red="0.95" green="0.94" blue="0.90"/>
			<color state="1" red="0.90" green="0.50" blue="0.10"/>
		</rect>
	</element>

	<element name="tecla_preta" defstate="0">
		<rect><bounds x="0" y="0" width="16" height="82"/><color red="0" green="0" blue="0"/></rect>
		<rect>
			<bounds x="1" y="0" width="14" height="80"/>
			<color state="0" red="0.10" green="0.10" blue="0.10"/>
			<color state="1" red="0.90" green="0.50" blue="0.10"/>
		</rect>
	</element>

<!-- ===
     SCREEN PRINTING.  Portuguese, as on the apparatus; spaced out the way
     src/mame/layout/patinho.lay spaces NORMAL, PARTIDA and PREPARACAO.
     === -->

	<element name="str_titulo">
		<text string="S I N T E T I Z A D O R   D E   S O M"><color red="0" green="0" blue="0"/></text>
	</element>
	<element name="str_epusp">
		<text string="E P U S P"><color red="0" green="0" blue="0"/></text>
	</element>

	<element name="str_pgrf_hdr">
		<text string="P A I N E L   G R Á F I C O   ( P G R F )       M E I O   C I C L O   D E   U M A   F U N Ç Ã O   Í M P A R"><color red="0" green="0" blue="0"/></text>
	</element>
	<element name="str_pgrf_nota">
		<text string="16 CHAVES DESLIZANTES DE 16 POSIÇÕES CADA — COMO NO APARELHO (CAP. 3)"><color red="0.16" green="0.16" blue="0.14"/></text>
	</element>
	<element name="str_nivel"><text string="NÍVEL"><color red="0" green="0" blue="0"/></text></element>
	<element name="str_amostra"><text string="AMOSTRA"><color red="0" green="0" blue="0"/></text></element>

	<element name="str_s1_hdr">
		<text string="S E L E T O R   S 1"><color red="0" green="0" blue="0"/></text>
	</element>
	<element name="str_AUTO"><text string="A U T O"><color red="0" green="0" blue="0"/></text></element>
	<element name="str_PGRF"><text string="P G R F"><color red="0" green="0" blue="0"/></text></element>
	<repeat count="7">
		<param name="i" start="1" increment="1"/>
		<element name="str_M~i~"><text string="M~i~"><color red="0" green="0" blue="0"/></text></element>
	</repeat>

	<element name="str_transf_hdr">
		<text string="T R A N S F E R E"><color red="0" green="0" blue="0"/></text>
	</element>
	<element name="str_transf_cap">
		<text string="D O   P A I N E L   P A R A   A   M E M Ó R I A"><color red="0" green="0" blue="0"/></text>
	</element>

	<element name="str_teclado_hdr">
		<text string="T E C L A D O"><color red="0" green="0" blue="0"/></text>
	</element>
	<element name="str_chave_ma">
		<text string="C H A V E   M A N U A L  -  A U T O M Á T I C O"><color red="0" green="0" blue="0"/></text>
	</element>
	<element name="str_MANUAL"><text string="M A N U A L" align="1"><color red="0" green="0" blue="0"/></text></element>
	<element name="str_AUTOMATICO"><text string="A U T O M Á T I C O" align="1"><color red="0" green="0" blue="0"/></text></element>
	<element name="str_transp_cap">
		<text string="T R A N S P O S I Ç Ã O   D E   O I T A V A S"><color red="0" green="0" blue="0"/></text>
	</element>

	<!-- the range the transposition switch is on right now.  Same seven
	     readings as the PORT_CONFSETTING lines of synth.cpp. -->
	<element name="str_transp_faixa" defstate="2">
		<text state="0" string="DÓ0 (16,35 Hz)  a  DÓ4 (261,6 Hz)"><color red="0" green="0" blue="0"/></text>
		<text state="1" string="DÓ1 (32,7 Hz)  a  DÓ5 (523,3 Hz)"><color red="0" green="0" blue="0"/></text>
		<text state="2" string="DÓ2 (65,4 Hz)  a  DÓ6 (1046,5 Hz)"><color red="0" green="0" blue="0"/></text>
		<text state="3" string="DÓ3 (130,8 Hz)  a  DÓ7 (2093,0 Hz)"><color red="0" green="0" blue="0"/></text>
		<text state="4" string="DÓ4 (261,6 Hz)  a  DÓ8 (4186,0 Hz)"><color red="0" green="0" blue="0"/></text>
		<text state="5" string="DÓ5 (523,3 Hz)  a  DÓ9 (8372,0 Hz)"><color red="0" green="0" blue="0"/></text>
		<text state="6" string="DÓ6 (1046,5 Hz)  a  DÓ10 (16744,0 Hz)"><color red="0" green="0" blue="0"/></text>
	</element>

	<element name="str_manual49_hdr">
		<text string="M A N U A L   D E   4 9   T E C L A S"><color red="0" green="0" blue="0"/></text>
	</element>
	<element name="str_DO"><text string="DÓ"><color red="0" green="0" blue="0"/></text></element>
	<!-- The keyboard itself IS emulated - it really drives the note and the
	     gate.  What is not emulated is the rest of what chapter 3 lists at its
	     output, and the panel says so rather than leaving it to a comment. -->
	<element name="str_lvd">
		<text string="AS SAÍDAS L, D E VBR"><bounds x="0" y="0" width="210" height="14"/><color red="0.20" green="0.14" blue="0.10"/></text>
		<text string="DO TECLADO"><bounds x="0" y="16" width="210" height="14"/><color red="0.20" green="0.14" blue="0.10"/></text>
		<text string="NÃO SÃO EMULADAS"><bounds x="0" y="32" width="210" height="14"/><color red="0.20" green="0.14" blue="0.10"/></text>
	</element>

	<!-- Visible until the script hides it, so a session run with -noplugins
	     says why the mouse does nothing to the sliders. -->
	<element name="str_aviso_plugin" defstate="1">
		<text state="1" string="PARA ARRASTAR AS CHAVES COM O MOUSE, O PLUGIN &quot;layout&quot; TEM DE ESTAR ATIVO  —  SEM ELE, USE Tab -&gt; Slider Controls">
			<color red="0.35" green="0.10" blue="0.02"/>
		</text>
	</element>

	<!-- 0 to 15, for the sample numbers and the level scale -->
	<repeat count="16">
		<param name="i" start="0" increment="1"/>
		<element name="str_num_~i~"><text string="~i~"><color red="0" green="0" blue="0"/></text></element>
	</repeat>

<!-- =====================================================================
     GROUPS
     ===================================================================== -->

		<!-- Local coordinates 60 x 320: the cursor centre travels from y = 310
	     (value 0) to y = 10 (value 15).  The drag library requires the click
	     area to span exactly that travel plus half a cursor at each end. -->
	<group name="amostra">
		<bounds x="0" y="0" width="60" height="320"/>

		<element ref="canal_chave"><bounds x="0" y="0" width="60" height="320"/></element>
		<element ref="trilho_chave"><bounds x="25" y="8" width="10" height="304"/></element>

		<element ref="barra_onda">
			<animate inputtag="~porta~" inputmask="0xff"/>
			<bounds state="0"  x="6" y="308" width="48" height="2"/>
			<bounds state="15" x="6" y="10"  width="48" height="300"/>
		</element>

		<element id="~id~" ref="area_invisivel">
			<bounds x="0" y="0" width="60" height="320"/>
		</element>

		<element id="cursor_~id~" ref="cursor_chave">
			<animate inputtag="~porta~" inputmask="0xff"/>
			<bounds state="0"  x="4" y="300" width="52" height="20"/>
			<bounds state="15" x="4" y="0"   width="52" height="20"/>
		</element>
	</group>

<!-- =====================================================================
     VIEW
     ===================================================================== -->

	<view name="Painel do sintetizador">
		<bounds x="0" y="0" width="1280" height="1080"/>

		<element ref="fundo_painel"><bounds x="0" y="0" width="1280" height="1080"/></element>

		<!-- title -->
		<element ref="faixa_titulo"><bounds x="40" y="16" width="1200" height="40"/></element>
		<element ref="str_titulo"><bounds x="360" y="26" width="440" height="20"/></element>
		<element ref="str_epusp"><bounds x="1080" y="26" width="120" height="20"/></element>

		<!-- ==============================================================
		     THE GRAPHIC PANEL
		     ============================================================== -->
		<element ref="faixa_titulo"><bounds x="40" y="70" width="1200" height="30"/></element>
		<element ref="str_pgrf_hdr"><bounds x="60" y="77" width="1160" height="16"/></element>

		<!-- level scale, 15 at the top down to 0 at the zero line -->
		<element ref="str_nivel"><bounds x="40" y="112" width="52" height="14"/></element>
		<repeat count="16">
			<param name="lv" start="15" increment="-1"/>
			<param name="ytexto" start="133" increment="20"/>
			<param name="ytraco" start="139" increment="20"/>
			<element ref="str_num_~lv~"><bounds x="44" y="~ytexto~" width="30" height="14"/></element>
			<element ref="traco"><bounds x="80" y="~ytraco~" width="12" height="2"/></element>
		</repeat>

		<!-- the zero line of the half cycle, under every bar -->
		<element ref="traco"><bounds x="94" y="439" width="1114" height="2"/></element>

		<!-- the sixteen sliders -->
		<repeat count="16">
			<param name="n" start="0" increment="1"/>
			<param name="x" start="96" increment="70"/>
			<param name="porta" value="AM~n~"/>
			<param name="id" value="am~n~"/>
			<group ref="amostra"><bounds x="~x~" y="130" width="60" height="320"/></group>
		</repeat>

		<!-- sample numbers, 0 to 15 -->
		<element ref="str_amostra"><bounds x="26" y="456" width="66" height="14"/></element>
		<repeat count="16">
			<param name="n" start="0" increment="1"/>
			<param name="x" start="99" increment="70"/>
			<element ref="str_num_~n~"><bounds x="~x~" y="456" width="54" height="16"/></element>
		</repeat>

		<element ref="str_pgrf_nota"><bounds x="40" y="478" width="1200" height="14"/></element>

		<!-- ==============================================================
		     S1, THE NINE-POSITION SELECTOR
		     ============================================================== -->
		<element ref="faixa_titulo"><bounds x="40" y="520" width="320" height="28"/></element>
		<element ref="str_s1_hdr"><bounds x="60" y="526" width="280" height="16"/></element>

		<!-- Clicking the knob steps to the next position: the field carries
		     PORT_TOGGLE, so a press runs select_next_setting() and cycles
		     AUTO -> PGRF -> M1 ... M7 -> AUTO. -->
		<element ref="knob_s1" inputtag="S1" inputmask="0x0f" inputraw="yes">
			<bounds x="120" y="630" width="160" height="160"/>
		</element>

		<element ref="lampada_s1_0" inputtag="S1" inputmask="0x0f" inputraw="yes"><bounds x="113" y="749" width="14" height="14"/></element>
		<element ref="lampada_s1_1" inputtag="S1" inputmask="0x0f" inputraw="yes"><bounds x="101" y="703" width="14" height="14"/></element>
		<element ref="lampada_s1_2" inputtag="S1" inputmask="0x0f" inputraw="yes"><bounds x="113" y="657" width="14" height="14"/></element>
		<element ref="lampada_s1_3" inputtag="S1" inputmask="0x0f" inputraw="yes"><bounds x="147" y="623" width="14" height="14"/></element>
		<element ref="lampada_s1_4" inputtag="S1" inputmask="0x0f" inputraw="yes"><bounds x="193" y="611" width="14" height="14"/></element>
		<element ref="lampada_s1_5" inputtag="S1" inputmask="0x0f" inputraw="yes"><bounds x="239" y="623" width="14" height="14"/></element>
		<element ref="lampada_s1_6" inputtag="S1" inputmask="0x0f" inputraw="yes"><bounds x="273" y="657" width="14" height="14"/></element>
		<element ref="lampada_s1_7" inputtag="S1" inputmask="0x0f" inputraw="yes"><bounds x="285" y="703" width="14" height="14"/></element>
		<element ref="lampada_s1_8" inputtag="S1" inputmask="0x0f" inputraw="yes"><bounds x="273" y="749" width="14" height="14"/></element>

		<element ref="str_AUTO"><bounds x="51" y="767" width="72" height="16"/></element>
		<element ref="str_PGRF"><bounds x="34" y="702" width="72" height="16"/></element>
		<element ref="str_M1"><bounds x="69" y="637" width="36" height="16"/></element>
		<element ref="str_M2"><bounds x="117" y="589" width="36" height="16"/></element>
		<element ref="str_M3"><bounds x="182" y="572" width="36" height="16"/></element>
		<element ref="str_M4"><bounds x="247" y="589" width="36" height="16"/></element>
		<element ref="str_M5"><bounds x="295" y="637" width="36" height="16"/></element>
		<element ref="str_M6"><bounds x="312" y="702" width="36" height="16"/></element>
		<element ref="str_M7"><bounds x="295" y="767" width="36" height="16"/></element>

		<!-- ==============================================================
		     THE SEVEN TRANSFERE COMMANDS
		     ============================================================== -->
		<element ref="faixa_titulo"><bounds x="400" y="520" width="520" height="28"/></element>
		<element ref="str_transf_hdr"><bounds x="420" y="526" width="480" height="16"/></element>
		<element ref="str_transf_cap"><bounds x="400" y="562" width="520" height="16"/></element>

		<repeat count="7">
			<param name="i" start="1" increment="1"/>
			<param name="x" start="430" increment="68"/>
			<param name="mask" start="0x01" lshift="1"/>
			<element ref="botao_transfere" inputtag="TRANSF" inputmask="~mask~">
				<bounds x="~x~" y="590" width="56" height="56"/>
			</element>
			<element ref="str_M~i~"><bounds x="~x~" y="654" width="56" height="16"/></element>
		</repeat>

		<!-- ==============================================================
		     THE KEYBOARD'S OWN TWO SWITCHES
		     ============================================================== -->
		<element ref="faixa_titulo"><bounds x="950" y="520" width="290" height="28"/></element>
		<element ref="str_teclado_hdr"><bounds x="960" y="526" width="270" height="16"/></element>

		<element ref="str_chave_ma"><bounds x="950" y="558" width="290" height="14"/></element>
		<element ref="chave_2pos" inputtag="TECL" inputmask="0x01" inputraw="yes">
			<bounds x="960" y="586" width="64" height="64"/>
		</element>
		<element ref="lampada_tecl_0" inputtag="TECL" inputmask="0x01" inputraw="yes"><bounds x="1040" y="592" width="14" height="14"/></element>
		<element ref="str_MANUAL"><bounds x="1062" y="590" width="170" height="16"/></element>
		<element ref="lampada_tecl_1" inputtag="TECL" inputmask="0x01" inputraw="yes"><bounds x="1040" y="624" width="14" height="14"/></element>
		<element ref="str_AUTOMATICO"><bounds x="1062" y="622" width="170" height="16"/></element>

		<element ref="str_transp_cap"><bounds x="950" y="670" width="290" height="14"/></element>
		<element ref="knob_transp" inputtag="TRANSP" inputmask="0x07" inputraw="yes">
			<bounds x="1050" y="710" width="90" height="90"/>
		</element>
		<element ref="str_num_1"><bounds x="1019" y="748" width="20" height="14"/></element>
		<element ref="str_num_2"><bounds x="1028" y="715" width="20" height="14"/></element>
		<element ref="str_num_3"><bounds x="1052" y="691" width="20" height="14"/></element>
		<element ref="str_num_4"><bounds x="1085" y="682" width="20" height="14"/></element>
		<element ref="str_num_5"><bounds x="1118" y="691" width="20" height="14"/></element>
		<element ref="str_num_6"><bounds x="1142" y="715" width="20" height="14"/></element>
